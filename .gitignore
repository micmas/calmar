# Runtime data — generated by the pipeline, not source
data/
atlases/
reports/
qc_edits/

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/
*.ipynb.bak

# macOS
.DS_Store
.fuse_hidden*

# R
*.RData

# Archives — use versioned zips if needed (see CHANGELOG.md notes)
*.zip

# stroke-aphasia-kb/ is a git submodule (github.com/micmas/stroke-aphasia-kb);
# its own .gitignore governs its contents. The rules below are kept so a
# checkout that has not initialised the submodule stays clean.
# Knowledge base raw papers (copyright — not redistributed; available on request)
stroke-aphasia-kb/papers

# Neurosynth cache (large, regenerated by neurosynth_bootstrap.py / decode_lesion.py)
stroke-aphasia-kb/_neurosynth_cache/
.ipynb_checkpoints/
.claude/settings.local.json

# Agent working notes / handoff docs (session-local, not source)
notes/

# Local execution logs and verification artifacts; retain scripts/specifications.
logs/
/alignment-repair/alignment_qc
/alignment-repair/corrected_disconnectomes
/alignment-repair/control_mask.nii.gz
/alignment-repair/*.prov.json
/workflow-validation/verification
/workflow-validation/*.prov.json

# Acceptance products are runtime data; retain only the plan and requests.
/workflow-acceptance/*
!/workflow-acceptance/astra.yaml
!/workflow-acceptance/request.json
!/workflow-acceptance/inspection-request.json
!/workflow-acceptance/atlas-request.json
!/workflow-acceptance/overlap-request.json
!/workflow-acceptance/decode-request.json
!/workflow-acceptance/preview-request.json
!/workflow-acceptance/bcb-request.json

# Notebook edit locks
/.*.edit-lock

# Local-extraction scratch files. These contain verbatim paper text —
# committing them would undo the point of extracting locally.
stroke-aphasia-kb/_extraction_dry_run.txt
stroke-aphasia-kb/drafts/_review/
stroke-aphasia-kb/_last_extraction_response_*.txt
stroke-aphasia-kb/_last_backfill_response_*.txt
stroke-aphasia-kb/_compare/
.env

# Local Python virtual environment
.venv/
